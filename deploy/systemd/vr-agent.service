[Unit]
Description=VR Agent scheduled task runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/vr/agent
ExecStart=/vr/agent/vr_agent --service
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=300s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
